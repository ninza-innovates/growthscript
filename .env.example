# Supabase project URL, used by the browser and server clients
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key, used by the browser and server clients
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe secret key, used to initialize the server-side Stripe client
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
